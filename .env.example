# Copy to .env. Never commit .env.

# Deployment. Hostname for automatic HTTPS, or :80 for plain HTTP behind a tunnel.
API_DOMAIN=:80
# Comma-separated
ALLOWED_ORIGINS=http://localhost:3000

# Data services
# Use the Supabase transaction pooler (port 6543). The session pooler allows only 15 clients.
DATABASE_URL=
# The project URL only, with no /rest/v1/ on the end.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=documents

# Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=

# gemini or openai: tried first for LLM calls and OCR. The other is the fallback if configured.
# Embeddings always use Gemini, because vectors from different models can't be compared.
PRIMARY_PROVIDER=gemini

# Models: fix these from the providers' live model lists (task 0.4)
LLM_PRIMARY_MODEL=gemini-3.5-flash
# The OpenAI model, whichever provider is tried first.
LLM_FALLBACK_MODEL=
# Used for triage, which only decides whether to carry on.
LLM_FAST_MODEL=gemini-3.5-flash-lite
# Flash-lite swapped real Hindi words on a scanned circular, so OCR uses the stronger model.
# It needs Gemini billing: the Free Tier allows 20 requests a day. Without billing, use
# gemini-3.5-flash-lite, and have a reader check the OCR output.
OCR_MODEL=gemini-3.5-flash
OCR_FALLBACK_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-2
# Must match EMBEDDING_MODEL. Migrations need it before they can run.
EMBEDDING_DIM=3072
TTS_MODEL=bulbul:v4-flash
TRANSLATE_MODEL=sarvam-translate:v1
STT_MODEL=saaras:v4

# Limits
MAX_CONCURRENT_RUNS=3
MAX_LLM_CALLS=60
RUN_TIMEOUT_S=420
MAX_PDF_MB=50
MAX_PAGES=200
PROFILE_TTL_S=3600
CROSS_PROVIDER_VERIFY=false

# Uploads wait here until the acquire node stores them.
# Keep this on a persistent volume so queued runs survive a rebuild.
UPLOAD_DIR=.uploads
