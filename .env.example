# Data services
# Use the Supabase session pooler or direct connection string.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
# The project URL only, with no /rest/v1/ on the end.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=documents

# Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=

# Models: fix these from the providers' live model lists (task 0.4)
LLM_PRIMARY_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODEL=
OCR_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-2
# Must match EMBEDDING_MODEL. Migrations need it before they can run.
EMBEDDING_DIM=3072
TTS_MODEL=bulbul:v4-flash
TRANSLATE_MODEL=sarvam-translate:v1
STT_MODEL=saaras:v4

# Limits
MAX_CONCURRENT_RUNS=3
MAX_LLM_CALLS=60
RUN_TIMEOUT_S=180
MAX_PDF_MB=50
MAX_PAGES=200
PROFILE_TTL_S=3600
CROSS_PROVIDER_VERIFY=false

# Comma-separated
ALLOWED_ORIGINS=http://localhost:3000

# Uploads wait here until the acquire node stores them.
# Keep this on a persistent volume so queued runs survive a restart.
UPLOAD_DIR=.uploads
