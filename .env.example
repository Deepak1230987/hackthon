# Copy to .env. Never commit .env.

# Deployment. Hostname for automatic HTTPS, or :80 for plain HTTP behind a tunnel.
API_DOMAIN=:80
ALLOWED_ORIGINS=http://localhost:3000

# Data services
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=

# Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=

# Models: fix these from the providers' live model lists (task 0.4)
LLM_PRIMARY_MODEL=
LLM_FALLBACK_MODEL=
OCR_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIM=
TTS_MODEL=bulbul:v4-flash
TRANSLATE_MODEL=sarvam-translate:v1
STT_MODEL=saaras:v4

# Limits
MAX_CONCURRENT_RUNS=3
MAX_LLM_CALLS=60
RUN_TIMEOUT_S=180
MAX_PDF_MB=50
MAX_PAGES=200
PROFILE_TTL_S=3600
CROSS_PROVIDER_VERIFY=false
