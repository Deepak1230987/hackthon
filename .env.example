# Copy to .env. Never commit .env.

# Deployment. Hostname for automatic HTTPS, or :80 for plain HTTP behind a tunnel.
API_DOMAIN=:80
# Comma-separated
ALLOWED_ORIGINS=http://localhost:3000

# Data services
# Use the Supabase transaction pooler (port 6543). The session pooler allows only 15 clients.
DATABASE_URL=
# The project URL only, with no /rest/v1/ on the end.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=documents

# Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=

# Models: fix these from the providers' live model lists (task 0.4)
# The name decides the provider: gpt-* uses OpenAI and gemini-* uses Gemini.
# The primary is tried first. A model whose provider has no key is skipped.
LLM_PRIMARY_MODEL=gpt-5.4-mini
LLM_FALLBACK_MODEL=gemini-3.5-flash
# Used first for triage, which only decides whether to carry on.
LLM_FAST_MODEL=gpt-5.4-mini
OCR_MODEL=gpt-5.4-mini
# Flash-lite swapped real Hindi words on a scanned circular, so don't use it here with billing on.
OCR_FALLBACK_MODEL=gemini-3.5-flash
# Always Gemini: vectors from different models can't be compared, so this has no fallback.
EMBEDDING_MODEL=gemini-embedding-2
# Must match EMBEDDING_MODEL. Migrations need it before they can run.
EMBEDDING_DIM=3072
TTS_MODEL=bulbul:v4-flash
TTS_VOICE=ritu_hi_customer
TTS_VOICE_MR=ritu_mr_narration
TRANSLATE_MODEL=sarvam-translate:v1
STT_MODEL=saaras:v4

# Limits
MAX_CONCURRENT_RUNS=3
MAX_LLM_CALLS=60
RUN_TIMEOUT_S=420
MAX_PDF_MB=50
# A longer document asks for a page range of at most this many pages.
MAX_PAGES=200
# New runs per IP address per window. Raise it if several people demo from one network.
MAX_RUNS_PER_IP=5
RUN_LIMIT_WINDOW_S=600
MAX_QUESTIONS_PER_RUN=20
MAX_STT_PER_RUN=20
PROFILE_TTL_S=3600
# Sends fact checks to LLM_FALLBACK_MODEL first, so another provider checks the primary's claims.
CROSS_PROVIDER_VERIFY=false

# Uploads wait here until the acquire node stores them.
# Keep this on a persistent volume so queued runs survive a rebuild.
UPLOAD_DIR=.uploads
