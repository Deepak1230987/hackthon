{$API_DOMAIN::80} {
	# Slightly above MAX_PDF_MB to allow for multipart overhead. The backend
	# enforces the real limit and returns FILE_TOO_LARGE.
	request_body {
		max_size 55MB
	}

	# SSE must reach the browser immediately: no buffering and no compression.
	@events path_regexp ^/v1/runs/[^/]+/events$
	handle @events {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		encode gzip
		reverse_proxy api:8000
	}
}
